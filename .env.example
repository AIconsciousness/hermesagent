# ===========================================
# Hermes Agent — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.

# DeepSeek API key (from platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your Telegram numeric user ID (the ONLY person who can control the bot)
TELEGRAM_CHAT_ID=123456789

# GitHub personal access token (repo scope) for auto-commits
GITHUB_TOKEN=ghp_yourgithubtoken

# GitHub repo URL with embedded token: https://GITHUB_TOKEN@github.com/user/repo.git
GITHUB_REPO_URL=https://ghp_yourgithubtoken@github.com/your-username/your-repo.git

# Render external URL (e.g., https://hermes-agent.onrender.com)
RENDER_EXTERNAL_URL=https://your-app.onrender.com